# -*- Makefile -*-


# the isce3 lib
isce3.lib.root := cxx/isce3/
isce3.lib.stem := isce3
isce3.lib.extern := gdal hdf5 eigen fftw pyre
# if we have cuda
ifdef cuda.dir
  # add it to the pile of external dependencies
  isce3.lib.extern += cuda
endif

# mga's ampcor uses the old {grid} api; exclude it for now
isce3.lib.directories.exclude += matchtemplate/ampcor
# if there is no cuda
ifndef cuda.dir
  # exclude the cuda source
  isce3.lib.directories.exclude += cuda
endif

# the files that have expansion tokens
isce3.lib.headers.autogen := config.h.in
isce3.lib.sources.autogen := config.cpp.in
# the expansion rules
isce3.lib.autogen := \
  @PROJECT_VERSION_MAJOR@|$(isce3.major) \
  @PROJECT_VERSION_MINOR@|$(isce3.minor) \
  @PROJECT_VERSION_PATCH@|$(isce3.micro) \
  @ISCE3_VERSION_FULL@|$(isce3.full) \
  @ISCE3_WITH_CUDA_BOOL@|$(isce3.cuda)

# use c++23 for host code
isce3.lib.c++.flags += $($(compiler.c++).std.c++23)
# and c++20 for device code
isce3.lib.cuda.flags += $($(compiler.cuda).std.c++20)

# enable some advanced nvcc features
isce3.lib.cuda.flags += --expt-relaxed-constexpr --extended-lambda

# after https://github.com/NVIDIA/cccl/pull/443, thrust creates an architecture specific
# inline namespace for all its symbols. #1756 added these symbols to suppress this.
# see the comments in cxx/isce3/cuda/CMakeLists.txt
# IMO, this should be considered a temporary fix, as thrust is likely to evolve to lean on
# this namespace
isce3.lib.c++.defines += THRUST_DISABLE_ABI_NAMESPACE THRUST_IGNORE_ABI_NAMESPACE_ERROR
isce3.lib.cuda.defines += THRUST_DISABLE_ABI_NAMESPACE THRUST_IGNORE_ABI_NAMESPACE_ERROR


# end of file
